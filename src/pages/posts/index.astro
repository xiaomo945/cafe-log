---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date - a.data.date
);

const fmt = (d) =>
  d.toLocaleDateString("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" });
---

<BaseLayout title="日志" description="从 2026-05-11 开始的原始记录" active="posts">
  <h1>日志</h1>
  <p style="color: var(--text-dim);">
    原始的、没修饰过的记录。共 {posts.length} 篇。
  </p>

  {
    posts.map((p) => (
      <div class="card">
        <div
          style="font-family: var(--font-mono); font-size: 0.8rem; color: var(--amber); margin-bottom: 6px;"
        >
          {fmt(p.data.date)}
        </div>
        <a href={`/posts/${p.slug}`} style="font-size: 1.12rem; font-weight: 700;">
          {p.data.title}
        </a>
        {p.data.summary && (
          <p style="margin: 8px 0 0; color: var(--text-dim); font-size: 0.94rem;">
            {p.data.summary}
          </p>
        )}
        <div style="margin-top: 10px;">
          {p.data.tags.map((t) => (
            <span class="tag">{t}</span>
          ))}
        </div>
      </div>
    ))
  }
</BaseLayout>
