---
import BaseLayout from "../layouts/BaseLayout.astro";
import { timeline } from "../data/timeline.js";
import { totalCost, totalIncome } from "../data/ledger.js";
import { projects, totalCommits } from "../data/projects.js";

const start = new Date("2026-05-11");
const now = new Date("2026-10-21");
const days = Math.floor((now - start) / 86400000);

// 首页只放关键节点
const keyNodes = timeline.filter((t) => t.key);

// 首页导流区：挑最能代表当前的项目（在线 + 重点游戏 + 近期网页独立版）
const statusText = { live: "已上线", building: "进行中", stopped: "已停", dead: "建议放弃" };
const statusCls = { live: "live", building: "done", stopped: "stop", dead: "stop" };
const kindText = { web: "网页", game: "游戏", tool: "工具", app: "应用", note: "记录" };
const featured = ["useaitools-me", "veggie-arena", "bottlesort-web", "puzzle-web", "star-rift-miner"]
  .map((n) => projects.find((p) => p.name === n))
  .filter(Boolean);
---

<BaseLayout title="起点" active="home">
  <h1>一天 30 块钱</h1>

  <p style="font-size: 1.1rem; margin-bottom: 6px;">
    我是保定一名出租车司机。
  </p>
  <p style="font-size: 1.05rem; color: var(--text-dim); margin-bottom: 22px;">
    2026 年 5 月 11 日，收车之后，我在一家网吧开机，
    买下 <code>useaitools.me</code>，给自己定了 10 小时做出一个能赚钱的网站的计划。
    到今天，第 {days} 天。
    <br />
    最近两个月，一天跑车下来平均 30 块左右；5 月份行情好时，一天能跑 100 到 150 块。
  </p>

  <div class="stats">
    <div class="stat amber"><span class="num">¥30</span><span class="label">日均跑车(近两月)</span></div>
    <div class="stat"><span class="num">{days}</span><span class="label">天</span></div>
    <div class="stat"><span class="num">{projects.length}</span><span class="label">个项目</span></div>
    <div class="stat blue"><span class="num">{totalCommits}</span><span class="label">次提交</span></div>
    <div class="stat red"><span class="num">¥{totalCost}</span><span class="label">累计投入</span></div>
    <div class="stat green"><span class="num">¥{totalIncome}</span><span class="label">累计收入</span></div>
  </div>

  <div class="card" style="border-color: rgba(240,180,41,0.25); background: var(--amber-glow);">
    <p style="margin: 0; color: #f5e6c8;">
      <strong style="color: var(--amber);">¥438 是什么概念</strong><br />
      按一天挣 30 块算，这笔买域名的钱，是我 <strong>14.6 天</strong>的全部收入。
      一分不剩，全投进去了。
    </p>
  </div>

  <p style="margin-top: 22px; padding: 14px 18px; border-left: 3px solid var(--amber); background: var(--amber-glow); border-radius: 0 var(--radius) var(--radius) 0; color: #f5e6c8;">
    <strong style="color: var(--amber);">这几个月我没闲着。</strong>
    24 个仓库、{totalCommits} 次提交，从 AI 工具站做到 Godot 游戏、倒瓶子小游戏、直播助手、刷新率工具。
    以前网站没把这些写出来，现在补上了——在 <a href="/projects">项目</a> 和 <a href="/timeline">时间线</a> 里，能看到每一份努力。
  </p>

  <p style="margin-top: 26px;">
    我没有办公室，没有独立工位，没有一整段不被打断的时间。
    代码是在跑车间隙写的，文章是在网吧按小时买来的时间里敲的。
    最近两个月一天跑车下来挣 30 块，5 月好的时候能到 100 多；再拿出其中一部分去上网。
  </p>

  <p style="color: var(--text-dim);">
    到今天 {days} 天，做了 {projects.length} 个项目，收入 ¥0。
    数字不好看。但把它们放在这里，是因为它们是真的。
  </p>

  <h2>为什么会有这个站</h2>

  <p>
    一开始只是想记流水账。后来发现，<strong>记录本身就是一种验证</strong>——
    你写下的每一条计划、每一次被拒、每一个"下次一定"，半年后回头看，
    会非常诚实地告诉你：你到底是能力不够，还是根本没做。
  </p>

  <p>
    还有一层更实在的：我一天挣 30 块。
    如果有人愿意看一个出租车司机怎么跟 AI 死磕，
    那这些字就可能变成我跑车之外的另一条路。
  </p>

  <p>
    我不确定这条路最后会不会走通。但有两件事是确定的：
  </p>

  <blockquote>
    <p>
      如果哪天成了，这个站就是证据——它记下了还没成时的样子，
      一天 30 块的日子、网吧的键盘、还有那笔相当于半个月收入的域名钱。
      <br /><br />
      如果哪天不做了，这个站就是交代——至少我没有糊弄过去，
      我知道自己走到过哪里。
    </p>
  </blockquote>

  <h2>能点开的东西</h2>

  <div
    class="card"
    style="border-color: rgba(0,198,255,0.3); background: linear-gradient(135deg, rgba(0,198,255,0.08), rgba(168,85,247,0.06)); margin-bottom: 22px;"
  >
    <div style="display: flex; align-items: center; gap: 14px; flex-wrap: wrap;">
      <span style="font-size: 2rem;">🎮</span>
      <div style="flex: 1; min-width: 200px;">
        <strong style="font-size: 1.1rem; color: #cfe9ff;">我的游戏合集 · shouyou.me</strong>
        <p style="margin: 4px 0 0; color: var(--text-dim); font-size: 0.9rem;">
          像素打砖块、星际裂矿者已上线，倒瓶子 / 拼图将陆续接入；还有显示器刷新率切换工具。所有源码都在 GitHub。
        </p>
      </div>
      <a class="card-link" href="https://shouyou.me" target="_blank" rel="noopener">↗ 进游戏广场</a>
    </div>
  </div>
  <p style="color: var(--text-dim);">
    下面这些是已经上线、或者源码能看的。点开就是我的全部项目 ——
    能玩的玩一玩，能用的打开看看，没上线的可以去源码里翻。
  </p>

  <div class="grid">
    {
      featured.map((p) => (
        <div class="card" style="margin-bottom: 0; display: flex; flex-direction: column;">
          <div style="display: flex; gap: 8px; margin-bottom: 10px; flex-wrap: wrap;">
            <span class={`tag ${statusCls[p.status]}`}>{statusText[p.status]}</span>
            <span class="tag">{kindText[p.kind]}</span>
          </div>
          <strong style="font-size: 1.04rem;">{p.name}</strong>
          <p style="margin: 8px 0 0; font-size: 0.9rem; color: var(--text-dim); flex: 1;">
            {p.intro}
          </p>
          <div style="margin-top: 14px;">
            {p.url ? (
              <a class="card-link" href={p.url} target="_blank" rel="noopener">
                {p.kind === "game" ? "▶ 玩一玩" : "↗ 打开网站"}
              </a>
            ) : (
              <a class="card-link ghost" href={`https://github.com/xiaomo945/${p.name}`} target="_blank" rel="noopener">
                ↗ 看源码
              </a>
            )}
          </div>
        </div>
      ))
    }
  </div>

  <p style="margin-top: 22px;">
    <a href="/projects">看全部 21 个项目 →</a>
  </p>

  <h2>关键节点</h2>

  <div class="timeline">
    {
      keyNodes.map((t) => (
        <div class="tl-item key">
          <div class="tl-date">{t.date}</div>
          <div class="tl-title">{t.title}</div>
          <div class="tl-body">
            {t.quote && (
              <blockquote style="margin: 14px 0;">
                <p>{t.quote}</p>
              </blockquote>
            )}
          </div>
        </div>
      ))
    }
  </div>

  <p style="margin-top: 30px;">
    <a href="/timeline">查看完整时间线 →</a>
  </p>

  <h2>这个站会怎么长</h2>

  <p>现在是纯文字。以后会慢慢加东西：</p>

  <ul>
    <li><strong>图片</strong> —— 网吧的桌子、第一次跑通的截图、失败项目的界面</li>
    <li><strong>视频</strong> —— 如果开了 TikTok / YouTube / B 站账号，视频会直接嵌进来，也能跳过去看</li>
    <li><strong>更多复盘</strong> —— 每停下一个项目，就写清楚「卡在哪」</li>
  </ul>

  <p style="color: var(--text-dim); font-size: 0.92rem;">
    内容是 Markdown 存的，所以以后想把某篇文章改成视频脚本，
    原文直接就能用 —— 这也是从一开始就没选复杂框架的原因。
  </p>
</BaseLayout>
