---
import BaseLayout from "../layouts/BaseLayout.astro";
import { timeline } from "../data/timeline.js";
---

<BaseLayout title="时间线" description="从 2026-05-11 保定一家网吧开始，到今天的完整记录" active="timeline">
  <h1>时间线</h1>
  <p style="color: var(--text-dim);">
    从 2026 年 5 月 11 日开始。带光点的是关键节点。
  </p>

  <div class="timeline">
    {
      timeline.map((t) => (
        <div class={`tl-item ${t.key ? "key" : ""}`}>
          <div class="tl-date">{t.date}</div>
          <div class="tl-title">
            {t.title}
            {t.tags &&
              t.tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
          <div class="tl-body">
            {t.body.map((p) => (
              <p set:html={p.replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>")} />
            ))}
            {t.quote && (
              <blockquote>
                <p>{t.quote}</p>
              </blockquote>
            )}
          </div>
        </div>
      ))
    }
  </div>

  <hr />

  <p style="color: var(--text-faint); font-size: 0.88rem;">
    这些记录来自 devlog 仓库的 9 篇原始日志、devlog-private 的收支表，
    以及 17 个仓库的 git 时间戳。没有修饰，只有事实。
  </p>
</BaseLayout>
