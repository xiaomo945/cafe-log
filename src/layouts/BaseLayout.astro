---
import "../styles/global.css";
import VideoEmbed from "../components/VideoEmbed.astro";
import ImageFigure from "../components/ImageFigure.astro";

interface Props {
  title: string;
  description?: string;
  active?: string;
}

const {
  title,
  description = "保定出租车司机，一天 30 块，用 AI 做产品与游戏的真实记录。163 天，20 个项目，1400+ 次提交。",
  active = "",
} = Astro.props;

const nav = [
  { href: "/", label: "起点", key: "home" },
  { href: "/timeline", label: "时间线", key: "timeline" },
  { href: "/ledger", label: "收支", key: "ledger" },
  { href: "/projects", label: "项目", key: "projects" },
  { href: "https://shouyou.me", label: "游戏", key: "games", external: true },
  { href: "/posts", label: "日志", key: "posts" },
  { href: "/about", label: "关于", key: "about" },
  { href: "/growth", label: "成长", key: "growth" },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · cafeaitools.com</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- SEO -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="cafeaitools.com" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Google Analytics（GA4）· 衡量 ID G-7B09SHWGWM · 全站统一统计 -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-7B09SHWGWM"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag("js", new Date());
      // 增强型衡量（滚动 / 出站点击 / 视频互动 / 文件下载）已在 GA 后台开启，config 即可生效
      gtag("config", "G-7B09SHWGWM", {
        anonymize_ip: true,        // 匿名化 IP，符合隐私合规
        page_location: location.href,
        page_title: document.title,
      });
    </script>

    <!-- 让 VideoEmbed / ImageFigure 在 Markdown 里可直接用 -->
  </head>

  <body>
    <div id="reading-progress" class="reading-progress" aria-hidden="true"></div>
    <header class="site-header">
      <div class="wrap inner">
        <a href="/" class="brand">cafeaitools<span class="dot">.</span>com</a>
        <nav class="nav">
          {
            nav.map((n) => (
              <a
                href={n.href}
                class={active === n.key ? "active" : ""}
                {...(n.external ? { target: "_blank", rel: "noopener" } : {})}
              >
                {n.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p>
          cafeaitools.com — 记录从 2026-05-11 保定一家网吧开始的那条路。
        </p>
        <p>
          至今 163 天 · 20 个项目 · 投入 ¥438 · 收入 ¥0。
          <br />
          如果哪天这个站有意义了，那是因为它记下了还没成功时的样子。
        </p>
        <p style="margin-top: 10px;">
          <a
            href="https://github.com/xiaomo945"
            target="_blank"
            rel="noopener"
            style="color: var(--amber); text-decoration: none;"
          >
            GitHub 仓库 ↗ github.com/xiaomo945
          </a>
          <br />
          <a
            href="https://shouyou.me"
            target="_blank"
            rel="noopener"
            style="color: var(--text-dim); text-decoration: none; font-size: 0.9rem;"
          >
            游戏合集 ↗ shouyou.me
          </a>
        </p>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var bar = document.getElementById("reading-progress");
        if (!bar) return;
        var ticking = false;
        function update() {
          var h = document.documentElement;
          var max = h.scrollHeight - h.clientHeight;
          var pct = max > 0 ? (h.scrollTop || document.body.scrollTop) / max : 0;
          bar.style.transform = "scaleX(" + Math.min(1, Math.max(0, pct)) + ")";
          ticking = false;
        }
        window.addEventListener("scroll", function () {
          if (!ticking) { window.requestAnimationFrame(update); ticking = true; }
        }, { passive: true });
        update();
      })();
    </script>
  </body>
</html>
